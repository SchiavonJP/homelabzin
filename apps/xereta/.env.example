# Private runtime file: /root/xereta/.env (0600), outside the checkout.
XERETA_DATABASE_URL=postgresql+psycopg://xereta:REPLACE@192.168.0.210:5432/knowledge_curator
XERETA_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
XERETA_OWNER_EMAIL=owner@example.invalid
XERETA_OWNER_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
XERETA_AGENT_READ_TOKEN=REPLACE_WITH_RANDOM_TOKEN
XERETA_LITELLM_KEY=REPLACE_PRIVATELY
XERETA_STATE_PATH=/data
XERETA_SILVERBULLET_URL=http://192.168.0.12:3011
XERETA_HINDSIGHT_URL=http://127.0.0.1:8888
XERETA_HINDSIGHT_BANK=knowledge-vault-pilot
XERETA_PUBLISH_ENABLED=false
XERETA_ACCEPTANCE_PASSED=false

# Optional read-only AFFiNE reader; keep its token private. No scope is approved by these settings.
XERETA_AFFINE_READER_URL=http://192.168.0.221:3012
XERETA_AFFINE_READER_TOKEN=REPLACE_WITH_READER_BEARER_TOKEN
XERETA_AFFINE_WORKSPACES='["WORKSPACE_ID"]'
# Verified import mappings only: workspace/document -> existing vault path.
XERETA_AFFINE_IMPORTS='{}'

XERETA_LITELLM_MODEL=generalist
# Optional Karakeep integration. Configure privately; activation is separate.
XERETA_KARAKEEP_URL=http://192.168.0.12:3000
XERETA_PUBLIC_KARAKEEP_URL=https://keep.joaopaulo.me
XERETA_KARAKEEP_TOKEN=
XERETA_LIBRARY_ENABLED=false
# Public article fetch hosts, exact names only. Never allow private destinations.
XERETA_ARTICLE_DOMAINS='[]'
