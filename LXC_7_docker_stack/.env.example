# LXC 7 — Monitor + Homepage

# Dockhand — Postgres em LXC 5
DOCKHAND_DB_USER=secondbrain
DOCKHAND_DB_PASS=

# Homepage — widgets que precisam de autenticação
# Proxmox API token (criar em Datacenter → Permissions → API Tokens)
PROXMOX_TOKEN_ID=homepage@pam!homepage
PROXMOX_TOKEN_SECRET=

# API keys dos *arr (Settings → General → API Key em cada serviço)
# Opcional — remove o widget se não quiser
JELLYFIN_API_KEY=
RADARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=
