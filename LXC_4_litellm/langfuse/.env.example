# Postgres — DB dedicado no LXC 5 (criar antes: CREATE DATABASE langfuse;)
LANGFUSE_DATABASE_URL=postgresql://secondbrain:SENHA@192.168.0.210:5432/langfuse

# ClickHouse (interno — container na mesma rede)
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=senha_forte_clickhouse
CLICKHOUSE_URL=http://sb_clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://sb_clickhouse:9000

# Redis — reusar LXC 5
REDIS_CONNECTION_STRING=redis://:SENHA_REDIS@192.168.0.210:6379

# Auth — gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=string_aleatoria_32_chars
SALT=string_aleatoria_32_chars
# gerar com: openssl rand -hex 32
ENCRYPTION_KEY=string_hex_64_chars

# Usuário admin criado automaticamente na primeira inicialização
LANGFUSE_ADMIN_EMAIL=seu@email.com
LANGFUSE_ADMIN_PASSWORD=senha_admin

# MinIO — object storage local (S3-compatible, obrigatório no Langfuse v3)
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=senha_forte_minio
