<clickhouse>
    <!-- Limites de memória para homelab — ratio removido, só o limite fixo vale -->
    <max_server_memory_usage>900000000</max_server_memory_usage>

    <!-- 2026-11-17: disco do CT 105 encheu (95%). Causa raiz:
         system.text_log com level=trace e sem TTL → ~20 GB em 3 meses.
         Logger de arquivo em warning + TTL nos logs internos. -->
    <logger>
        <level>warning</level>
    </logger>

    <text_log>
        <level>warning</level>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </text_log>

    <!-- Tabelas de log interno sem <engine> explícito no config base: o <ttl>
         aqui vale. Para query_log e opentelemetry_span_log (que TÊM <engine>),
         o TTL foi aplicado via ALTER TABLE SQL — config rejeitaria. -->
    <trace_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </trace_log>
    <processors_profile_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </processors_profile_log>
    <metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <query_metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_metric_log>
    <part_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>

    <!-- LXC sem IPv6 — escuta apenas em IPv4 -->
    <listen_host>0.0.0.0</listen_host>

    <!-- ClickHouse Keeper embutido — necessário para ReplicatedMergeTree sem ZooKeeper externo -->
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>localhost</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>

    <!-- Aponta ClickHouse para o Keeper local -->
    <zookeeper>
        <node>
            <host>localhost</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <!-- Cluster single-node para Langfuse ON CLUSTER default -->
    <remote_servers>
        <default>
            <shard>
                <replica>
                    <host>localhost</host>
                    <port>9000</port>
                </replica>
            </shard>
        </default>
    </remote_servers>

    <macros>
        <cluster>default</cluster>
        <shard>1</shard>
        <replica>1</replica>
    </macros>
</clickhouse>
