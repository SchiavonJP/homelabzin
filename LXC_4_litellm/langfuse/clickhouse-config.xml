<clickhouse>
    <!-- Limites de memória para homelab — ratio removido, só o limite fixo vale -->
    <max_server_memory_usage>900000000</max_server_memory_usage>

    <!-- LXC sem IPv6 — escuta apenas em IPv4 -->
    <listen_host>0.0.0.0</listen_host>

    <!-- ClickHouse Keeper embutido — necessário para ReplicatedMergeTree sem ZooKeeper externo -->
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>localhost</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>

    <!-- Aponta ClickHouse para o Keeper local -->
    <zookeeper>
        <node>
            <host>localhost</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <!-- Cluster single-node para Langfuse ON CLUSTER default -->
    <remote_servers>
        <default>
            <shard>
                <replica>
                    <host>localhost</host>
                    <port>9000</port>
                </replica>
            </shard>
        </default>
    </remote_servers>

    <macros>
        <cluster>default</cluster>
        <shard>1</shard>
        <replica>1</replica>
    </macros>
</clickhouse>
