# LiteLLM — chaves de segurança
# LITELLM_MASTER_KEY deve começar com sk-
LITELLM_MASTER_KEY=sk-your_master_key_here

LITELLM_SALT_KEY=your_random_hex_salt_64_chars

# Postgres no LXC 5 — database dedicado ao LiteLLM
DATABASE_URL=postgresql://secondbrain:your_postgres_password@192.168.0.210:5432/secondbrain

# Redis no LXC 5
REDIS_URL=redis://:your_redis_password@192.168.0.210:6379

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Langfuse — gerar em https://langfuse.joaopaulo.me → Settings → API Keys
# (preencher após subir o Langfuse pela primeira vez)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# VPN UFSC — pra alcançar o Ollama remoto (ollama.vlab.ufsc.br)
# Usuário no formato idUFSC completo: nome.sobrenome@ufsc.br
# NUNCA usar a variante @grad ou @posgrad (a UFSC rejeita essas)
UFSC_VPN_USERNAME=nome.sobrenome@ufsc.br
UFSC_VPN_PASSWORD=your_ufsc_password

# Ollama remoto (atrás de Basic Auth em ollama.vlab.ufsc.br) — URL completa
# com usuário:senha embutidos, pra usar como api_base direto no config.yaml
# (LiteLLM só substitui os.environ/VAR como campo inteiro, não dá pra
# interpolar usuário/senha dentro de uma string maior).
UFSC_OLLAMA_API_BASE=https://user:password@ollama.vlab.ufsc.br/v1

# Fallback — só usar se o api_base acima não bastar pro Basic Auth passar
# (ver seção "VPN UFSC" no readme). Gerar com:
# echo -n 'usuario:senha' | base64
UFSC_OLLAMA_AUTH_HEADER=Basic your_base64_user_colon_password
