config setup
    charondebug="ike 1, knl 1, cfg 1"

conn ufsc
    keyexchange=ikev2
    right=vpn.ufsc.br
    # Servidor se autentica com certificado próprio (padrão IKEv2 roadwarrior).
    # Se a validação falhar, buscar o certificado da CA da UFSC/ICPEdu e
    # colocar em /etc/ipsec.d/cacerts/ dentro do container (via volume) —
    # não desative rightauth pra "resolver", isso quebra a validação do servidor.
    rightauth=pubkey
    # Restringe o túnel só à rede da UFSC — confirmado rodando que
    # 0.0.0.0/0 virava full-tunnel de fato (Postgres em 192.168.0.210 deu
    # timeout com o seletor amplo). vpn.ufsc.br é 150.162.0.67 e o IP
    # virtual atribuído a nós foi 150.162.166.10 — mesmo bloco /16.
    rightsubnet=150.162.0.0/16
    # Cliente se autentica via usuário/senha (EAP) — a UFSC exige o wrapper
    # EAP-PEAP (não EAP-MSCHAPv2 puro, confirmado rodando: o servidor
    # respondia EAP/REQ/PEAP e falhava no NAK pedindo MSCHAPv2 direto).
    # phase2_method do plugin eap-peap já é mschapv2 por padrão, então o
    # usuário/senha por baixo continuam os mesmos.
    leftauth=eap-peap
    leftid=${UFSC_USERNAME}
    eap_identity=${UFSC_USERNAME}
    leftsourceip=%config
    dpdaction=restart
    dpddelay=30s
    closeaction=restart
    auto=start
