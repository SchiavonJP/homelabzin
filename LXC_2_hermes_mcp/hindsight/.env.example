# Private runtime file: copy to .env on sb-hermes, mode 0600. Never commit it.
# The database must be separate from every existing application database, with
# vector and pg_trgm installed by its administrator before application startup.
HINDSIGHT_API_DATABASE_URL=postgresql://knowledge_pilot:REPLACE_WITH_PRIVATE_PASSWORD@192.168.0.210:5432/knowledge_pilot
HINDSIGHT_API_LLM_API_KEY=REPLACE_WITH_EXISTING_LITELLM_CREDENTIAL
# No default: a deployment must deliberately select a qualified model.
HINDSIGHT_PILOT_MODEL=
