# Karakeep — ver docs.karakeep.app/configuration

# Gerar com: openssl rand -base64 36 | tr -dc 'A-Za-z0-9'
MEILI_MASTER_KEY=your_meilisearch_master_key

# Gerar com: openssl rand -base64 36 | tr -dc 'A-Za-z0-9'
NEXTAUTH_SECRET=your_nextauth_secret

NEXTAUTH_URL=https://keep.joaopaulo.me

# --- Vídeo: NÃO setar CRAWLER_VIDEO_DOWNLOAD ---
# Default oficial é `false` (usa yt-dlp só se explicitamente habilitado).
# Deixar essa variável ausente garante que vídeos/áudios de links salvos
# (ex: YouTube) NUNCA são baixados — só URL, título, thumbnail, descrição,
# tags e metadados de busca são armazenados.
# CRAWLER_VIDEO_DOWNLOAD=true   <- NUNCA DESCOMENTAR

# Arquivamento de página completa — default oficial `false`. Mantido
# desligado por ora (decisão do operador); screenshot (CRAWLER_STORE_SCREENSHOT,
# default `true`) continua ativo para preview visual do link.
# CRAWLER_FULL_PAGE_ARCHIVE=true

# Fechar cadastro — só habilitar DEPOIS de criar a conta admin inicial pela UI.
# DISABLE_SIGNUPS=true

# IA desligada por decisão do operador (sem LiteLLM nesta implantação).
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=
