# Apollo — llama-server environment
# Copy to .env and adjust before running setup.sh
# setup.sh sources this file; values are written to /etc/llama-server.env

# ── Model preset ─────────────────────────────────────────────
# Selects model, NGL default, and preset-specific flags.
# Override individual vars below to tune within a preset.
#
# qwen3      → Qwen3.6-35B-A3B-MTP Q4_K_M  (~11.4 GiB VRAM, NGL=22, ~25–35 t/s)
# gemma3-12b → Gemma 3 12B IT Q4_K_M       (~9 GiB VRAM,  NGL=99, ~60–100 t/s)
#
MODEL_PRESET=qwen3

# OpenAI-compatible API port
LLAMA_PORT=8080

# Context window in tokens
# qwen3:      KV cache ~688 MiB at 8K (q8_0) — don't increase without reducing NGL
# gemma3-12b: KV cache ~1.5 GiB at 8K (q8_0) — can go to 12K safely
LLAMA_CTX_SIZE=8192

# GPU layers to offload (preset default used if not set here)
# qwen3:      NGL=22 stable with bge-m3 na CPU (NGL=23 = OOM)
# gemma3-12b: NGL=99 (all 46 layers fit comfortably in 12 GiB)
# LLAMA_NGL=22

# ── bge-m3 embedding service (porta 8081) ──────────────────────
BGE_PORT=8081
BGE_MODEL_PATH=/models/bge-m3-Q4_K_M.gguf
BGE_CTX_SIZE=8192
# bge-m3 Q4_K_M is ~570 MB — set BGE_NGL=0 to run on CPU (recommended with qwen3)
BGE_NGL=0
