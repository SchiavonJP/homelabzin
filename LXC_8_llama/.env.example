# Apollo — llama-server environment
# Copy to .env and adjust before running setup.sh
# setup.sh sources this file; values are written to /etc/llama-server.env

# OpenAI-compatible API port
LLAMA_PORT=8080

# Absolute path to the GGUF model file
LLAMA_MODEL_PATH=/models/Qwen3.6-35B-A3B-MTP-Q4_K_M.gguf

# Context window in tokens
# 16K = default with bge-m3 coexisting on same GPU (KV cache ~1.4GB at Q8_0)
# 32K = only safe if bge-m3 is stopped OR NGL is reduced to ~30
# KV cache scales linearly: doubling ctx doubles KV VRAM usage
LLAMA_CTX_SIZE=16384

# GPU layers to offload
# Qwen3.6-35B-A3B-MTP Q4_K_M total file ~20GB; RTX 3060 has 12GB
# With bge-m3 (570MB) on the same GPU, ~11.4GB available for Qwen
# With ctx=16K + bge-m3 (400MB): NGL=45 leaves ~600MB headroom in 12GB VRAM
# With ctx=32K: reduce NGL to ~30 to compensate for larger KV cache
LLAMA_NGL=45

# ── bge-m3 embedding service (porta 8081) ──────────────────────
BGE_PORT=8081
BGE_MODEL_PATH=/models/bge-m3-Q4_K_M.gguf
BGE_CTX_SIZE=8192
# bge-m3 Q4_K_M is ~570 MB — offload all layers (24 total)
BGE_NGL=99
