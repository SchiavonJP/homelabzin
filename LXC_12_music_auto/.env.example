# LXC 12 — Music Automation (Soularr + slskd + Beets)
# Copy to .env and fill in the values

# Lidarr API key (Settings → General → Security → API Key em 192.168.0.219:8686)
LIDARR_API_KEY=

# slskd API key (gerado no primeiro login em 192.168.0.221:5030 → Settings → API)
SLSKD_API_KEY=

# Credenciais Soulseek
SLSKD_SOULSEEK_USERNAME=
SLSKD_SOULSEEK_PASSWORD=
