# LXC 10 — Arr Stack + Music Automation

# Lidarr API key (Settings → General → Security → API Key em localhost:8686)
LIDARR_API_KEY=

# slskd — credenciais de acesso à web UI
SLSKD_USERNAME=admin
SLSKD_PASSWORD=

# slskd — conta Soulseek (criar em soulseekqt.com, é gratuito)
SLSKD_SOULSEEK_USERNAME=
SLSKD_SOULSEEK_PASSWORD=

# slskd API key (gerado após o primeiro login em localhost:5030 → Settings → API)
SLSKD_API_KEY=

# Token do Hawser (agente do Dockhand) — gerar em Dockhand → Settings →
# Environments → Add new environment (só aparece uma vez, copiar na hora)
HAWSER_TOKEN=your_hawser_agent_token
