# Postgres (interno — nunca publicado no host)
POSTGRES_PASSWORD=your_ryot_postgres_password

# Token de admin do Ryot — gerar com: openssl rand -base64 32
SERVER_ADMIN_ACCESS_TOKEN=your_ryot_admin_token

# TMDB — obrigatório pra busca de filmes/séries funcionar.
# Criar conta em themoviedb.org → Settings → API → Request an API Key (Developer)
# Copiar o "API Read Access Token" (token longo, NÃO a "API Key (v3 auth)" curta)
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token
