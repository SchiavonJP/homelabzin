# LXC 11 — Downloads (qBittorrent)
# Nenhuma variável obrigatória — credenciais configuradas via UI

# OPCIONAL: se usar Gluetun VPN como sidecar, adicionar aqui:
# VPN_SERVICE_PROVIDER=mullvad
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=<sua_chave>
# SERVER_COUNTRIES=Brazil

# Token do Hawser (agente do Dockhand) — gerar em Dockhand → Settings →
# Environments → Add new environment (só aparece uma vez, copiar na hora)
HAWSER_TOKEN=your_hawser_agent_token
